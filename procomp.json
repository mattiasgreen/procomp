{
  "builders": {},
  "runtimes": {
    "mock-broker": {
      "command": "java {{jvmArgs}} -Dservice.name={{servicename}} -Dservice.type=activemq -Dserver.port={{localport}} -Dhealth.path={{healthPath}} -Dstartup.delay.ms={{startupDelayMs}} -Dlog.format={{logFormat}} -jar \"{{root}}\\mock-service\\mock-service.jar\"",
      "healthPath": "/api/jolokia",
      "memoryArgPattern": "-Xmx(\\d+[kmgKMG]?)"
    },
    "mock-service": {
      "command": "java {{jvmArgs}} -Dservice.name={{servicename}} -Dservice.type=spring-boot -Dserver.port={{localport}} -Dhealth.path={{healthPath}} -Dstartup.delay.ms={{startupDelayMs}} -Dlog.format={{logFormat}} -jar \"{{root}}\\mock-service\\mock-service.jar\"",
      "healthPath": "/actuator/health",
      "memoryArgPattern": "-Xmx(\\d+[kmgKMG]?)"
    }
  },
  "gateway": {
    "type": "wiremock",
    "adminUrl": "http://127.0.0.1:8080"
  },
  "profiles": {
    "checkout": {
      "local":  ["activemq-broker", "order-service", "payment-service"],
      "remote": ["auth-service", "inventory-service", "notification-service"]
    }
  },
  "apps": [
    {
      "servicename": "activemq-broker",
      "localport": "8161",
      "type": "mock-broker",
      "vars": { "jvmArgs": "-Xmx256m", "startupDelayMs": "1800" },
      "proxyPath": "/activemq",
      "remoteUrl": "https://shared-dev.example.com/activemq",
      "logFormat": "text",
      "enabled": true
    },
    {
      "servicename": "auth-service",
      "localport": "8091",
      "subproject": "auth-service",
      "type": "mock-service",
      "swaggeruri": "swagger-ui/index.html",
      "vars": { "jvmArgs": "-Xmx384m", "startupDelayMs": "3000" },
      "proxyPath": "/auth",
      "remoteUrl": "https://shared-dev.example.com/auth",
      "logFormat": "text",
      "enabled": true
    },
    {
      "servicename": "order-service",
      "localport": "8082",
      "subproject": "order-service",
      "type": "mock-service",
      "swaggeruri": "swagger-ui/index.html",
      "vars": { "jvmArgs": "-Xmx384m", "startupDelayMs": "4200" },
      "proxyPath": "/orders",
      "remoteUrl": "https://shared-dev.example.com/orders",
      "logFormat": "json",
      "enabled": true
    },
    {
      "servicename": "payment-service",
      "localport": "8083",
      "subproject": "payment-service",
      "type": "mock-service",
      "swaggeruri": "swagger-ui/index.html",
      "vars": { "jvmArgs": "-Xmx384m", "startupDelayMs": "3500" },
      "proxyPath": "/payments",
      "remoteUrl": "https://shared-dev.example.com/payments",
      "logFormat": "json",
      "enabled": true
    },
    {
      "servicename": "inventory-service",
      "localport": "8084",
      "subproject": "inventory-service",
      "type": "mock-service",
      "swaggeruri": "swagger-ui/index.html",
      "vars": { "jvmArgs": "-Xmx256m", "startupDelayMs": "2800" },
      "proxyPath": "/inventory",
      "remoteUrl": "https://shared-dev.example.com/inventory",
      "logFormat": "text",
      "enabled": true
    },
    {
      "servicename": "notification-service",
      "localport": "8085",
      "subproject": "notification-service",
      "type": "mock-service",
      "swaggeruri": "swagger-ui/index.html",
      "vars": { "jvmArgs": "-Xmx256m", "startupDelayMs": "2500" },
      "proxyPath": "/notifications",
      "remoteUrl": "https://shared-dev.example.com/notifications",
      "logFormat": "text",
      "enabled": false
    }
  ]
}
