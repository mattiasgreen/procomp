{
  "builders": {
    "gradle-boot":   { "command": "gradlew.bat {{module}}:bootJar -q" },
    "maven-quarkus": { "command": "mvnw.cmd -pl {{module}} package -DskipTests -q" },
    "npm":           { "command": "npm run build" }
  },
  "runtimes": {
    "wiremock": {
      "command": "java {{jvmArgs}} -jar wiremock\\wiremock-standalone.jar --port {{port}} --root-dir wiremock",
      "healthPath": "/__admin/health",
      "memoryArgPattern": "-Xmx(\\d+[kmgKMG]?)"
    },
    "spring-boot": {
      "command": "java {{jvmArgs}} -Dserver.port={{port}} -Dspring.profiles.active=local -jar {{artifact}}",
      "healthPath": "/actuator/health",
      "artifactGlob": "{{modulePath}}\\build\\libs\\*.jar",
      "artifactExclude": "*-plain.jar",
      "memoryArgPattern": "-Xmx(\\d+[kmgKMG]?)"
    },
    "quarkus": {
      "command": "java {{jvmArgs}} -Dquarkus.http.port={{port}} -Dquarkus.profile=local -jar {{artifact}}",
      "healthPath": "/q/health/ready",
      "artifactGlob": "{{modulePath}}\\target\\quarkus-app\\quarkus-run.jar",
      "memoryArgPattern": "-Xmx(\\d+[kmgKMG]?)"
    },
    "node": {
      "command": "node dist\\index.js",
      "healthPath": "/health"
    }
  },
  "gateway": {
    "type": "wiremock",
    "adminUrl": "http://127.0.0.1:8080",
    "serviceName": "wiremock-gateway"
  },
  "profiles": {
    "checkout": {
      "local":  ["wiremock-gateway", "order-service", "billing-quarkus"],
      "remote": ["frontend-bff"]
    }
  },
  "services": [
    {
      "name": "wiremock-gateway",
      "runtime": "wiremock",
      "port": 8080,
      "vars": { "jvmArgs": "-Xmx256m" },
      "enabled": true
    },
    {
      "name": "order-service",
      "runtime": "spring-boot",
      "builder": "gradle-boot",
      "port": 8082,
      "repo": "../commerce-backend",
      "module": ":services:order-service",
      "vars": { "jvmArgs": "-Xmx384m" },
      "proxyPath": "/orders",
      "remoteUrl": "https://shared-dev.mycorp/orders",
      "logFormat": "json"
    },
    {
      "name": "billing-quarkus",
      "runtime": "quarkus",
      "builder": "maven-quarkus",
      "port": 8083,
      "repo": "../billing-repo",
      "module": "billing-api",
      "vars": { "jvmArgs": "-Xmx256m" },
      "proxyPath": "/billing",
      "remoteUrl": "https://shared-dev.mycorp/billing",
      "logFormat": "json"
    },
    {
      "name": "frontend-bff",
      "runtime": "node",
      "builder": "npm",
      "port": 3000,
      "repo": "../web-bff",
      "env": { "PORT": "3000" },
      "proxyPath": "/bff",
      "remoteUrl": "https://shared-dev.mycorp/bff"
    }
  ]
}
