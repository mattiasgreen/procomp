{
  "reposRoot": "..",
  "builders": {
    "gradle-boot":   { "command": "gradlew.bat {{subproject}}:bootJar -q" },
    "maven-quarkus": { "command": "mvnw.cmd -pl {{subproject}} package -DskipTests -q" },
    "npm":           { "command": "npm run build" }
  },
  "runtimes": {
    "wiremock": {
      "command": "java {{jvmArgs}} -jar wiremock\\wiremock-standalone.jar --port {{localport}} --root-dir wiremock",
      "healthPath": "/__admin/health",
      "memoryArgPattern": "-Xmx(\\d+[kmgKMG]?)"
    },
    "java": {
      "command": "java {{jvmArgs}} -Dserver.port={{localport}} -Dspring.profiles.active=local -jar {{artifact}}",
      "healthPath": "/actuator/health",
      "artifactGlob": "{{modulePath}}\\build\\libs\\*.jar",
      "artifactExclude": "*-plain.jar",
      "memoryArgPattern": "-Xmx(\\d+[kmgKMG]?)"
    },
    "quarkus": {
      "command": "java {{jvmArgs}} -Dquarkus.http.port={{localport}} -Dquarkus.profile=local -jar {{artifact}}",
      "healthPath": "/q/health/ready",
      "artifactGlob": "{{modulePath}}\\target\\quarkus-app\\quarkus-run.jar",
      "memoryArgPattern": "-Xmx(\\d+[kmgKMG]?)"
    },
    "node": {
      "command": "node dist\\index.js",
      "healthPath": "/health"
    }
  },
  "gateway": {
    "type": "wiremock",
    "adminUrl": "http://127.0.0.1:8080",
    "serviceName": "wiremock-gateway"
  },
  "profiles": {
    "checkout": {
      "local":  ["wiremock-gateway", "order-service", "billing-quarkus"],
      "remote": ["frontend-bff"]
    }
  },
  "apps": [
    {
      "servicename": "wiremock-gateway",
      "localport": "8080",
      "type": "wiremock",
      "vars": { "jvmArgs": "-Xmx256m" },
      "enabled": true
    },
    {
      "servicename": "order-service",
      "localport": "8082",
      "subproject": ":services:order-service",
      "type": "java",
      "builder": "gradle-boot",
      "swaggeruri": "swagger-ui/index.html",
      "servicerepositoryurl": "ssh://git@scm.corp:7999/acme/commerce-backend.git",
      "vars": { "jvmArgs": "-Xmx384m" },
      "proxyPath": "/orders",
      "remoteUrl": "https://shared-dev.mycorp/orders",
      "logFormat": "json"
    },
    {
      "servicename": "billing-quarkus",
      "localport": "8083",
      "subproject": "billing-api",
      "type": "quarkus",
      "builder": "maven-quarkus",
      "swaggeruri": "q/swagger-ui/",
      "servicerepositoryurl": "ssh://git@scm.corp:7999/acme/billing-repo.git",
      "vars": { "jvmArgs": "-Xmx256m" },
      "proxyPath": "/billing",
      "remoteUrl": "https://shared-dev.mycorp/billing",
      "logFormat": "json"
    },
    {
      "servicename": "frontend-bff",
      "localport": "3000",
      "subproject": "",
      "type": "node",
      "builder": "npm",
      "servicerepositoryurl": "ssh://git@scm.corp:7999/acme/web-bff.git",
      "env": { "PORT": "3000" },
      "proxyPath": "/bff",
      "remoteUrl": "https://shared-dev.mycorp/bff"
    }
  ]
}
