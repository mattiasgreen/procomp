{
  "project": "acme",
  "appsFile": "./service-index.json",
  "defaults": {
    "builder": "gradle",
    "enabled": false,
    "logFormat": "json",
    "proxyPathTemplate": "/{{servicename}}",
    "remoteUrlTemplate": "https://shared-dev.mycorp/{{servicename}}",
    "vars": {
      "jvmArgs": "-Xmx384m"
    }
  },
  "builders": {
    "gradle": { "command": "gradlew.bat {{gradleTaskPrefix}}assemble -q" }
  },
  "runtimes": {
    "java": {
      "command": "java {{jvmArgs}} -Dserver.port={{localport}} -Dspring.profiles.active=local -jar {{artifact}}",
      "healthPath": "/actuator/health",
      "artifactGlob": "{{modulePath}}\\build\\libs\\*.jar",
      "artifactExclude": "*-plain.jar",
      "memoryArgPattern": "-Xmx(\\d+[kmgKMG]?)"
    }
  },
  "gateway": {
    "type": "wiremock",
    "adminUrl": "http://127.0.0.1:8080"
  },
  "profiles": {
    "one-local": {
      "local":  ["service1"],
      "remote": ["*"]
    }
  }
}
