{
  "project": "acme",
  "repositoriesRoot": "..",
  "envFiles": [
    { "path": ".env.local", "optional": true }
  ],
  "defaults": {
    "builder": "gradle",
    "proxyPathTemplate": "/{{service}}",
    "remoteUrlTemplate": "https://shared-dev.mycorp/{{service}}",
    "vars": {
      "jvmArgs": ["-Xmx384m"]
    },
    "env": {
      "SPRING_PROFILES_ACTIVE": "local"
    }
  },
  "builders": {
    "gradle": {
      "command": ["./gradlew", ":{{subproject}}:bootJar", "--console=plain"]
    }
  },
  "runtimes": {
    "java": {
      "command": [
        "java",
        "{{jvmArgs}}",
        "-Dserver.port={{port}}",
        "-jar",
        "{{artifact}}"
      ],
      "healthPath": "/actuator/health",
      "artifactGlob": "{{subproject}}/build/libs/*.jar",
      "artifactExclude": "*-plain.jar"
    }
  },
  "gateway": {
    "type": "wiremock",
    "port": 8080,
    "healthPath": "/__admin/health"
  },
  "catalog": {
    "path": "./service-index.json",
    "itemsPath": "apps",
    "map": {
      "name": "servicename",
      "port": "localport",
      "runtime": "type",
      "repositoryUrl": "servicerepositoryurl",
      "vars.subproject": "subproject"
    }
  },
  "services": {
    "service1": {
      "vars": {
        "jvmArgs": ["-Xmx512m"]
      }
    }
  },
  "profiles": {
    "one-local": {
      "local": ["service1"]
    }
  }
}
