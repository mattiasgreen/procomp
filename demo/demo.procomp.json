{
  "reposRoot": ".demo_repos",
  "builders": {
    "mock-gradle": {
      "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"{{root}}\\demo\\mock-build.ps1\" -Tool gradle -Service {{servicename}} -Module {{subproject}}"
    },
    "mock-maven": {
      "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"{{root}}\\demo\\mock-build.ps1\" -Tool maven -Service {{servicename}} -Module {{subproject}}"
    },
    "mock-npm": {
      "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"{{root}}\\demo\\mock-build.ps1\" -Tool npm -Service {{servicename}}"
    }
  },
  "runtimes": {
    "wiremock": {
      "command": "java {{jvmArgs}} -Dservice.name={{servicename}} -Dservice.type=wiremock -Dserver.port={{localport}} -Dhealth.path={{healthPath}} -Dstartup.delay.ms={{startupDelayMs}} -Dlog.format=text -jar \"{{root}}\\mock-service\\mock-service.jar\"",
      "healthPath": "/__admin/health",
      "memoryArgPattern": "-Xmx(\\d+[kmgKMG]?)"
    },
    "activemq": {
      "command": "java {{jvmArgs}} -Dservice.name={{servicename}} -Dservice.type=activemq -Dserver.port={{localport}} -Dhealth.path={{healthPath}} -Dstartup.delay.ms={{startupDelayMs}} -Dlog.format=text -jar \"{{root}}\\mock-service\\mock-service.jar\"",
      "healthPath": "/api/jolokia",
      "memoryArgPattern": "-Xmx(\\d+[kmgKMG]?)"
    },
    "java": {
      "command": "java {{jvmArgs}} -Dservice.name={{servicename}} -Dservice.type=spring-boot -Dserver.port={{localport}} -Dhealth.path={{healthPath}} -Dstartup.delay.ms={{startupDelayMs}} -Dlog.format={{logFormat}} -jar \"{{root}}\\mock-service\\mock-service.jar\"",
      "healthPath": "/actuator/health",
      "memoryArgPattern": "-Xmx(\\d+[kmgKMG]?)"
    },
    "quarkus": {
      "command": "java {{jvmArgs}} -Dservice.name={{servicename}} -Dservice.type=quarkus -Dserver.port={{localport}} -Dhealth.path={{healthPath}} -Dstartup.delay.ms={{startupDelayMs}} -Dlog.format={{logFormat}} -jar \"{{root}}\\mock-service\\mock-service.jar\"",
      "healthPath": "/q/health/ready",
      "memoryArgPattern": "-Xmx(\\d+[kmgKMG]?)"
    },
    "node": {
      "command": "java {{jvmArgs}} -Dservice.name={{servicename}} -Dservice.type=node -Dserver.port={{localport}} -Dhealth.path={{healthPath}} -Dstartup.delay.ms={{startupDelayMs}} -Dlog.format={{logFormat}} -jar \"{{root}}\\mock-service\\mock-service.jar\"",
      "healthPath": "/health"
    }
  },
  "gateway": {
    "type": "wiremock",
    "adminUrl": "http://127.0.0.1:8088",
    "serviceName": "wiremock-gateway"
  },
  "profiles": {
    "checkout": {
      "local":  ["wiremock-gateway", "activemq-broker", "order-service", "billing-quarkus"],
      "remote": ["auth-service", "web-bff"]
    },
    "all-local": {
      "local":  ["wiremock-gateway", "activemq-broker", "auth-service", "order-service", "billing-quarkus", "web-bff"],
      "remote": []
    }
  },
  "apps": [
    {
      "servicename": "wiremock-gateway",
      "localport": "8088",
      "type": "wiremock",
      "vars": { "jvmArgs": "-Xmx128m", "startupDelayMs": "1000" },
      "logFormat": "text",
      "enabled": true
    },
    {
      "servicename": "activemq-broker",
      "localport": "8161",
      "type": "activemq",
      "vars": { "jvmArgs": "-Xmx192m", "startupDelayMs": "1400" },
      "proxyPath": "/activemq",
      "remoteUrl": "https://shared-dev.example.com/activemq",
      "logFormat": "text",
      "enabled": true
    },
    {
      "servicename": "auth-service",
      "localport": "8091",
      "subproject": ":services:auth-service",
      "type": "java",
      "builder": "mock-gradle",
      "swaggeruri": "swagger-ui/index.html",
      "servicerepositoryurl": "ssh://git@scm.corp:7999/acme/commerce-backend.git",
      "vars": { "jvmArgs": "-Xmx256m", "startupDelayMs": "2000" },
      "proxyPath": "/auth",
      "remoteUrl": "https://shared-dev.example.com/auth",
      "logFormat": "text",
      "enabled": true
    },
    {
      "servicename": "order-service",
      "localport": "8082",
      "subproject": ":services:order-service",
      "type": "java",
      "builder": "mock-gradle",
      "swaggeruri": "swagger-ui/index.html",
      "servicerepositoryurl": "ssh://git@scm.corp:7999/acme/commerce-backend.git",
      "vars": { "jvmArgs": "-Xmx384m", "startupDelayMs": "2500" },
      "proxyPath": "/orders",
      "remoteUrl": "https://shared-dev.example.com/orders",
      "logFormat": "json",
      "enabled": true
    },
    {
      "servicename": "billing-quarkus",
      "localport": "8083",
      "subproject": "billing-api",
      "type": "quarkus",
      "builder": "mock-maven",
      "swaggeruri": "q/swagger-ui/",
      "servicerepositoryurl": "ssh://git@scm.corp:7999/acme/billing-quarkus.git",
      "vars": { "jvmArgs": "-Xmx256m", "startupDelayMs": "1600" },
      "proxyPath": "/billing",
      "remoteUrl": "https://shared-dev.example.com/billing",
      "logFormat": "json",
      "enabled": true
    },
    {
      "servicename": "web-bff",
      "localport": "3000",
      "subproject": "",
      "type": "node",
      "builder": "mock-npm",
      "servicerepositoryurl": "ssh://git@scm.corp:7999/acme/web-bff.git",
      "vars": { "jvmArgs": "-Xmx128m", "startupDelayMs": "1200" },
      "proxyPath": "/bff",
      "remoteUrl": "https://shared-dev.example.com/bff",
      "logFormat": "text",
      "enabled": false
    }
  ]
}
