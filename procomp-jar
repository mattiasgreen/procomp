#!/usr/bin/env sh
set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
JAR_PATH="$SCRIPT_DIR/build/libs/procomp.jar"
if [ ! -f "$JAR_PATH" ]; then
  echo "Error: '$JAR_PATH' not found. Build it first with './gradlew :assemble'." >&2
  exit 1
fi

if [ -n "${JAVA_HOME:-}" ] && [ -x "$JAVA_HOME/bin/java" ]; then
  JAVA_BIN="$JAVA_HOME/bin/java"
else
  JAVA_BIN="java"
fi

exec "$JAVA_BIN" -jar "$JAR_PATH" "$@"
